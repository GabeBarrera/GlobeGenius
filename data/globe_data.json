    {
      "id": "ww2",
      "name": "World War II: A Global Conflict",
      "subtitle": "Alliances, supply lines and offensives · 1939–1945",
      "unit": "relative scale",
      "author": "Globe Genius",
      "version": "1.0",
      "yearFrom": 1939,
      "yearTo": 1945,
      "tags": [
        "history",
        "war"
      ],
      "sources": [
        {
          "id": "ws1",
          "label": "The National WWII Museum — Research & Collections",
          "url": "https://www.nationalww2museum.org"
        },
        {
          "id": "ws2",
          "label": "Imperial War Museums",
          "url": "https://www.iwm.org.uk"
        }
      ],
      "scenes": [
        {
          "id": "wsc1",
          "name": "Axis expansion",
          "text": "Germany invades the Soviet Union in June 1941; Japan strikes Pearl Harbor that December, pulling the United States into a war already raging across China.",
          "camera": {
            "rx": -20,
            "ry": -45,
            "zoom": 1
          },
          "flowIds": [
            "ww4",
            "ww5",
            "ww7"
          ]
        },
        {
          "id": "wsc2",
          "name": "Lend-lease lifelines",
          "text": "American convoys ferry tanks, aircraft, food and fuel across the Atlantic to Britain, through Arctic waters to the USSR, and across the Pacific to Australia.",
          "camera": {
            "rx": 40,
            "ry": -50,
            "zoom": 1
          },
          "flowIds": [
            "ww1",
            "ww2",
            "ww3"
          ]
        },
        {
          "id": "wsc3",
          "name": "The Allied counteroffensive",
          "text": "D-Day opens the Western Front in June 1944 while island-hopping campaigns close on Japan, ending the war in 1945.",
          "camera": {
            "rx": 0,
            "ry": -40,
            "zoom": 1
          },
          "flowIds": [
            "ww6",
            "ww8"
          ]
        }
      ],
      "writeup": "<h2>A war fought across oceans</h2><p>World War II was the first truly global war: its outcome turned as much on <b>shipping lanes and supply lines</b> as on battlefields. Darker bands mark Axis offensives; lighter bands trace the Allied lend-lease convoys that kept Britain and the Soviet Union fighting.</p><p>Page through the scenes below the globe to follow the war’s arc — Axis expansion, the lend-lease lifelines, and the Allied counteroffensive that ended it.</p>",
      "roles": [
        {
          "id": "allies",
          "name": "Allied powers",
          "color": "#8fae7e"
        },
        {
          "id": "axis",
          "name": "Axis powers",
          "color": "#c98d6e"
        },
        {
          "id": "neutral",
          "name": "Neutral states",
          "color": "#ddc8a0"
        }
      ],
